    <visualElement>
      <elementName>Text</elementName>
      <elementAttributes>
        <entry>
          <string>Description</string>
          <string>CP263 Lab 02_03 Full Adder (Sum of Products)

SOP_Sum = (A ^ B) ^ C_in = ~Cin(~A.B + A.~B) + Cin(A.B + ~A.~B)
SOP_Cout = A.B + C_in.(A ^ B)

Note : ^ = XOR = ~A.B + A.~B</string>
        </entry>
      </elementAttributes>
      <pos x="660" y="20"/>
    </visualElement>
    <visualElement>

      <elementAttributes>
        <entry>
          <string>Description</string>
          <string>CP263 Lab 02_04 Full Adder (Product of Sum)

POS_ Sum = (A+B+Cin).(A+~B+~Cin).(~A+B+~Cin).(~A+~B+Cin)
POS_ Cout = (A+B).(A+Cin).(B+Cin)

Note : ^ = XOR = ~A.B + A.~B</string>
        </entry>
      </elementAttributes>
      <pos x="380" y="100"/>
    </visualElement>
